{
  "name": "markdown-editor-pro",
  "version": "1.0.0",
  "description": "A Markdown editor built with Electron, React, TypeScript, and Vite.",
  "main": "./out/main/index.js",
  "author": {
    "name": "CRH",
    "email": "crh@example.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "npm run test:unit && npm run test:fixtures",
    "test:unit": "tsx scripts/tests/pure-logic.test.ts && tsx scripts/tests/editor-mode-switch.test.ts && tsx scripts/tests/editor-history.test.ts && tsx scripts/tests/mode-edit.test.ts && tsx scripts/tests/math-clipboard.test.ts && tsx scripts/tests/workflow-stress.test.ts && tsx scripts/tests/linux-mime.test.ts",
    "test:fixtures": "tsx scripts/tests/markdown-fixtures.test.ts",
    "build": "electron-vite build && electron-builder --config electron-builder.config.mjs",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.config.mjs --publish never",
    "build:linux:dir": "electron-vite build && electron-builder --linux --dir --config electron-builder.config.mjs --publish never",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.config.mjs --publish never",
    "build:dir": "electron-vite build && electron-builder --dir --config electron-builder.config.mjs --publish never",
    "preview": "electron-vite preview",
    "install:linux": "npm run build:linux:dir && bash scripts/install-linux.sh"
  },
  "dependencies": {
    "@aarkue/tiptap-math-extension": "^1.4.0",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "clsx": "^2.1.1",
    "katex": "^0.16.11",
    "lowlight": "^3.1.0",
    "mermaid": "^11.14.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
